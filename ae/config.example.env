export FDP_DEVICE=/dev/nvme0n1
export FDP_MOUNT_POINT=/mnt/fdp
export FDP_DB_DIR=/mnt/fdp/db
export FDP_PREFILL_SIZE=58G
export FDP_MIN_FREE_GIB=50

export PHASE1_KEYS=50000000
export PHASE2_KEYS=100000000
export VALUE_SIZE=800
export WORKER_THREADS=1
export COMPACTION_PRIORITY=BCS

export ROCKSDB_TOO_FAR_BUDGET_ADAPTIVE_PROBE_KN=0/10,5/10,10/10
export ROCKSDB_TOO_FAR_BUDGET_ADAPTIVE_PROBE_SLOT_SEC=10
export ROCKSDB_TOO_FAR_BUDGET_ADAPTIVE_EXPLOIT_SEC=60
export ROCKSDB_TOO_FAR_BUDGET_ADAPTIVE_PROBE_SHRINK=1
export ROCKSDB_TOO_FAR_BUDGET_ADAPTIVE_PROBE_METRIC=bps

export ROCKSDB_SOURCE_DIR="$PWD/third_party/rocksdb"
export BENCHMARK_DIR="$PWD/src/benchmark"
export KEY_DATASET_DIR=/path/to/key-order-files
export PHASE1_KEY_FILE="$KEY_DATASET_DIR/keys_num_50000000_threads_1_dist_uniform_sort_random_tid_0.bin"

export CONFIRM_ERASE_DB=NO
export CONFIRM_PREFILL=NO
export COLLECT_FDP_STATS=1
